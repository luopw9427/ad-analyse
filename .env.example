# 复制本文件为 .env，填入真实值。.env 不要提交到 Git（见 .gitignore）。
# 生产环境（Railway）请在项目 Variables 里配置，不要用文件。

# ── Cloudflare R2（对象存储）──
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=yunxi-peiwen
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-id.r2.dev

# ── OpenRouter（LLM 分析）──
OPENROUTER_API_KEY=sk-or-...

# ── 素材生成模块（Studio）──
# 视频：Seedance（seedanceapi.org）。填入你的 API key 即可生成视频（seedance-2.0 / -fast / -mini）。
SEEDANCE_KEY=
# 接口地址（一般不用改）
SEEDANCE_BASE=https://seedanceapi.org/v2
# 图片/其它视频模型（预留，接 fal FLUX / Replicate 时再填）
FAL_KEY=
REPLICATE_API_TOKEN=
# 内部积分（可选）：1 积分 = CREDIT_USD 美元；CREDITS_ENFORCE=1 时余额不足拒绝（一期建议 0=只记录不拦截，用 Seedance 自身账户额度）
CREDIT_USD=0.01
CREDITS_ENFORCE=0
